{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:monthly"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "mise version pinned for jdx/mise-action in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["uses: jdx/mise-action@\\S+.*\\n\\s+with:\\n\\s+version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "python stays at the oldest version the hooks support (macOS ships 3.9); raise it by hand",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
