  {
    "name": "list returns open items with metadata, skipping closed ones",
    "files": {
      "backlog.md": "# Backlog\n\n- [ ] alpha (2026-01-01, branch: main)\n- [x] gone (2026-01-01)\n- [ ] beta (2026-01-02)\n"
    },
    "op": "list",
    "expect": {
      "items": [
        "alpha (2026-01-01, branch: main)",
        "beta (2026-01-02)"
      ],
      "files": {
        "backlog.md": "# Backlog\n\n- [ ] alpha (2026-01-01, branch: main)\n- [x] gone (2026-01-01)\n- [ ] beta (2026-01-02)\n"
      }
    }
  },
  {
    "name": "list with no file is empty and creates nothing",
    "op": "list",
    "expect": {
      "items": [],
      "files": {}
    }
  },
  {
    "name": "done flips one box",
    "files": {
      "backlog.md": "# Backlog\n\n- [ ] alpha (2026-01-01)\n- [ ] beta (2026-01-02)\n"
    },
    "op": "done",
    "item": "beta (2026-01-02)",
    "expect": {
      "ok": true,
      "files": {
        "backlog.md": "# Backlog\n\n- [ ] alpha (2026-01-01)\n- [x] beta (2026-01-02)\n"
      }
    }
  },
  {
    "name": "note goes after existing sub-bullets",
    "files": {
